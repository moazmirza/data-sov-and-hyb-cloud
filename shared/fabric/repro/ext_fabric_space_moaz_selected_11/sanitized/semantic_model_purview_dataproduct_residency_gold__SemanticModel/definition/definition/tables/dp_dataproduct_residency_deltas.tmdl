table dp_dataproduct_residency_deltas
	lineageTag: db233c4e-0f53-424f-b29a-5829d7da21e3
	sourceLineageTag: [dbo].[dp_dataproduct_residency_deltas]

	measure 'Residency Changes (Last Run)' = ```
			
			VAR _latest =
			    CALCULATE (
			        MAX ( 'dp_dataproduct_residency_deltas'[SnapshotUtc] ),
			        ALL ( 'dp_dataproduct_residency_deltas' )
			    )
			RETURN
			    COALESCE (
			        CALCULATE (
			            COUNTROWS ( 'dp_dataproduct_residency_deltas' ),
			            FILTER (
			                ALL ( 'dp_dataproduct_residency_deltas' ),
			                'dp_dataproduct_residency_deltas'[SnapshotUtc] = _latest
			                    && 'dp_dataproduct_residency_deltas'[HasChanged] = TRUE ()
			            )
			        ),
			        0
			    )
			
			```
		formatString: 0
		lineageTag: dd5c5145-194d-44e8-8e5e-c21146da4a04

		changedProperty = Name

	column SnapshotUtc
		dataType: dateTime
		formatString: General Date
