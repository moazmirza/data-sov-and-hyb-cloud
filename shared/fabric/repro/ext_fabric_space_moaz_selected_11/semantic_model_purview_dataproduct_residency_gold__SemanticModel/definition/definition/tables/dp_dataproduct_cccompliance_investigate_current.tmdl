	measure 'CC - Investigation Required Count' =
			
			COUNTROWS('dp_dataproduct_cccompliance_investigate_current')
		formatString: 0
		lineageTag: e04bc758-f97f-48e1-bcb8-f0ed66266c85

		changedProperty = Name

	measure 'CC - Investigation Distinct Owners' =
			
			DISTINCTCOUNT('dp_dataproduct_cccompliance_investigate_current'[OwnerEmail])
		formatString: 0
		lineageTag: 97b6fcfb-e743-42a6-a8d3-39fd1a1ac506

		changedProperty = Name

	measure 'CC - Score 0 Count' =
			
			CALCULATE(
			    COUNTROWS('dp_dataproduct_cccompliance_current'),
