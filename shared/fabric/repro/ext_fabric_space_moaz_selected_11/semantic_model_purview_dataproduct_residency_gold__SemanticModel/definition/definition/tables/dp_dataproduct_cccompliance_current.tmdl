table dp_dataproduct_cccompliance_current
	lineageTag: 8a3344ed-882e-4366-80ce-e131527064db
	sourceLineageTag: [dbo].[dp_dataproduct_cccompliance_current]

	measure 'CC - Applicable PII Count' =
			
			CALCULATE(
			    COUNTROWS('dp_dataproduct_cccompliance_current'),
			    'dp_dataproduct_cccompliance_current'[CCForPIIStatus] = "Applicable"
			)
		formatString: 0
		lineageTag: b44196d4-bd9e-4863-8cbe-4effcc43b210

		changedProperty = Name

	measure 'CC - Overall Compliance Score (Applicable PII)' =
			
			VAR ApplicableRows =
			    FILTER(
			        'dp_dataproduct_cccompliance_current',
			        'dp_dataproduct_cccompliance_current'[CCForPIIStatus] = "Applicable"
			    )
			RETURN
			    IF(
			        COUNTROWS(ApplicableRows) = 0,
			        BLANK(),
			        AVERAGEX(ApplicableRows, 'dp_dataproduct_cccompliance_current'[CCForPIIScore])
			    )
		formatString: 0
		isHidden
		lineageTag: 2bd6df59-c58c-452a-be2e-f8f8b851b086

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = IsHidden

	measure 'CC - Score 100 Count' =
			
			CALCULATE(
			    COUNTROWS('dp_dataproduct_cccompliance_current'),
			    'dp_dataproduct_cccompliance_current'[CCForPIIScore] = 100
			)
		formatString: 0
		lineageTag: ad4352d7-7e53-485d-9e30-6632d5968e09

		changedProperty = Name

	measure 'CC - Score 25 Count' =
			
			CALCULATE(
			    COUNTROWS('dp_dataproduct_cccompliance_current'),
			    'dp_dataproduct_cccompliance_current'[CCForPIIScore] = 25
			)
		formatString: 0
		lineageTag: 6606525d-9418-41c7-988c-b9948108210e

		changedProperty = Name

	measure 'CC - Score 50 Count' =
			
			CALCULATE(
			    COUNTROWS('dp_dataproduct_cccompliance_current'),
			    'dp_dataproduct_cccompliance_current'[CCForPIIScore] = 50
			)
		formatString: 0
		lineageTag: aaf768b2-810a-4a61-a9cb-4e6d1c087a1c

		changedProperty = Name

	measure 'CC - Score 75 Count' =
			
			CALCULATE(
			    COUNTROWS('dp_dataproduct_cccompliance_current'),
			    'dp_dataproduct_cccompliance_current'[CCForPIIScore] = 75
			)
		formatString: 0
		lineageTag: 53358a1a-e61a-4639-9601-fac3f9e6acfc

		changedProperty = Name

	measure 'Avg CC Compliance Score %' =
			
			AVERAGE (dp_dataproduct_cccompliance_current[CCForPIIScore])
		lineageTag: d0534af9-34d2-4f00-9dcf-554be30cf135

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Patch Compliance Score %' =
			
			AVERAGEX(
			    'dp_dataproduct_cccompliance_current',
			    IF(
			        ISBLANK('dp_dataproduct_cccompliance_current'[PendingUpdatesTotal]) ||
			        'dp_dataproduct_cccompliance_current'[PendingUpdatesTotal] = 0,
			        100,
			        0
			    )
			)
		lineageTag: 07c3616a-f3b8-4eb1-9d1d-19a840b2d12f

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

