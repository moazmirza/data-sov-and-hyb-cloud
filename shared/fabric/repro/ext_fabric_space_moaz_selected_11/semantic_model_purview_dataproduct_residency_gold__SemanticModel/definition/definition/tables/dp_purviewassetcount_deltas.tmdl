table dp_purviewassetcount_deltas
	lineageTag: 24601635-8fe1-4616-894f-ffc486b4e26c
	sourceLineageTag: [dbo].[dp_purviewassetcount_deltas]

	measure 'Purview DeltaPct (Last Run)' =
			
			VAR _latest =
			    CALCULATE (
			        MAX ( 'dp_purviewassetcount_deltas'[SnapshotUtc] ),
			        ALL ( 'dp_purviewassetcount_deltas' )
			    )
			RETURN
			    CALCULATE (
			        MAX ( 'dp_purviewassetcount_deltas'[DeltaPct] ),
			        FILTER ( ALL ( 'dp_purviewassetcount_deltas' ), 'dp_purviewassetcount_deltas'[SnapshotUtc] = _latest )
			    )
		formatString: 0.00
		lineageTag: e556142a-61e1-4929-955b-255f3d41da9f

		changedProperty = Name

		changedProperty = FormatString

	measure 'Purview SpikeDrop Flag (Last Run)' = ```
			
			VAR _threshold = 0.05
			VAR _pct = [Purview DeltaPct (Last Run)]
			RETURN
			    IF ( NOT ISBLANK ( _pct ) && ABS ( _pct ) >= _threshold, 1, 0 )
			
			```
		formatString: 0
		lineageTag: 3c8f7120-56d6-4c08-b6c4-73e006e2ee5b

		changedProperty = Name

