table dp_sovereignty_kpis_timeline_table
	lineageTag: 81a59744-3938-46d6-99af-c4d9ccfcbcc4
	sourceLineageTag: [dbo].[dp_sovereignty_kpis_timeline_table]

	measure 'Products Missing Residency (Latest)' = ```
			
			VAR _latest =
			    CALCULATE (
			        MAX ( 'dp_sovereignty_kpis_timeline_table'[SnapshotUtc] ),
			        ALL ( 'dp_sovereignty_kpis_timeline_table' )
			    )
			RETURN
			    COALESCE (
			        CALCULATE (
			            MAX ( 'dp_sovereignty_kpis_timeline_table'[ProductsMissingResidency] ),
			            FILTER ( ALL ( 'dp_sovereignty_kpis_timeline_table' ), 'dp_sovereignty_kpis_timeline_table'[SnapshotUtc] = _latest )
			        ),
			        0
			    )
			
			```
		formatString: 0
		lineageTag: d379933d-dd1c-49ba-a89e-8cb6b1450a93

		changedProperty = Name

