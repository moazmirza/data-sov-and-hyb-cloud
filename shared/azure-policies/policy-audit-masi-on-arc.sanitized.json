{
  "description": "This policy audits Azure Arc-enabled machines that do not have a Managed Identity (System-Assigned) enabled, flagging them as non-compliant without making any changes.",
  "displayName": "audit-masi-on-arc-<ORG>",
  "id": "/subscriptions/<SUBSCRIPTION_ID>/providers/Microsoft.Authorization/policyDefinitions/<POLICY_DEFINITION_ID_AUDIT_MASI_ON_ARC>",
  "metadata": {
    "category": "<ORGANIZATION_NAME> Security",
    "createdBy": "<CREATED_BY_OBJECT_ID>",
    "createdOn": "<CREATED_TIMESTAMP_UTC>",
    "updatedBy": "<UPDATED_BY_OBJECT_ID>",
    "updatedOn": "<UPDATED_TIMESTAMP_UTC>"
  },
  "mode": "Indexed",
  "name": "<POLICY_DEFINITION_ID_AUDIT_MASI_ON_ARC>",
  "parameters": {
    "effect": {
      "allowedValues": [
        "Audit",
        "Disabled"
      ],
      "defaultValue": "Audit",
      "metadata": {
        "description": "Enable or disable the policy.",
        "displayName": "Effect"
      },
      "type": "String"
    }
  },
  "policyRule": {
    "if": {
      "allOf": [
        {
          "equals": "Microsoft.HybridCompute/machines",
          "field": "type"
        },
        {
          "anyOf": [
            {
              "exists": "false",
              "field": "identity.type"
            },
            {
              "field": "identity.type",
              "notContains": "SystemAssigned"
            }
          ]
        }
      ]
    },
    "then": {
      "effect": "[parameters('effect')]"
    }
  },
  "policyType": "Custom",
  "systemData": {
    "createdAt": "<CREATED_TIMESTAMP_UTC>",
    "createdBy": "<CREATED_BY_UPN_OR_SPN>",
    "createdByType": "User",
    "lastModifiedAt": "<UPDATED_TIMESTAMP_UTC>",
    "lastModifiedBy": "<UPDATED_BY_UPN_OR_SPN>",
    "lastModifiedByType": "User"
  },
  "type": "Microsoft.Authorization/policyDefinitions",
  "version": "1.0.0",
  "versions": [
    "1.0.0"
  ]
}
