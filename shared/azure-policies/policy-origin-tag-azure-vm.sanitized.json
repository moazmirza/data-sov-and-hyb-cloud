{
  "description": "This policy automatically tags Azure Virtual Machines with resource-origin = azure if that tag is missing or set to a different value.",
  "displayName": "dine-origin-tag-azure-if-azurevm-<ORG>",
  "id": "/subscriptions/<SUBSCRIPTION_ID>/providers/Microsoft.Authorization/policyDefinitions/<POLICY_DEFINITION_ID_AZURE_VM>",
  "metadata": {
    "category": "<ORGANIZATION_NAME> Security",
    "createdBy": "<CREATED_BY_OBJECT_ID>",
    "createdOn": "<CREATED_TIMESTAMP_UTC>",
    "updatedBy": "<UPDATED_BY_OBJECT_ID>",
    "updatedOn": "<UPDATED_TIMESTAMP_UTC>"
  },
  "mode": "Indexed",
  "name": "<POLICY_DEFINITION_ID_AZURE_VM>",
  "parameters": {
    "tagName": {
      "defaultValue": "resource-origin",
      "metadata": {
        "description": "Name of the tag to enforce.",
        "displayName": "Tag name"
      },
      "type": "String"
    },
    "tagValue": {
      "defaultValue": "azure",
      "metadata": {
        "description": "Value to enforce for the tag.",
        "displayName": "Tag value"
      },
      "type": "String"
    }
  },
  "policyRule": {
    "if": {
      "allOf": [
        {
          "equals": "Microsoft.Compute/virtualMachines",
          "field": "type"
        },
        {
          "field": "[concat('tags[', parameters('tagName'), ']')]",
          "notEquals": "[parameters('tagValue')]"
        }
      ]
    },
    "then": {
      "details": {
        "operations": [
          {
            "field": "[concat('tags[', parameters('tagName'), ']')]",
            "operation": "addOrReplace",
            "value": "[parameters('tagValue')]"
          }
        ],
        "roleDefinitionIds": [
          "/providers/Microsoft.Authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
        ]
      },
      "effect": "modify"
    }
  },
  "policyType": "Custom",
  "systemData": {
    "createdAt": "<CREATED_TIMESTAMP_UTC>",
    "createdBy": "<CREATED_BY_UPN_OR_SPN>",
    "createdByType": "User",
    "lastModifiedAt": "<UPDATED_TIMESTAMP_UTC>",
    "lastModifiedBy": "<UPDATED_BY_UPN_OR_SPN>",
    "lastModifiedByType": "User"
  },
  "type": "Microsoft.Authorization/policyDefinitions",
  "version": "1.0.0",
  "versions": [
    "1.0.0"
  ]
}
