{
  "description": "This policy automatically grants the Key Vault Secrets User role to the System-Assigned Managed Identity (SAMI) of Arc-enabled machines tagged with sovereignty-zone = comprehensive, giving them credential-free read access to secrets in a specified Key Vault.",
  "displayName": "dine-kv-secrets-user-to-sami-comprehensive-<ORG>",
  "id": "/subscriptions/<SUBSCRIPTION_ID>/providers/Microsoft.Authorization/policyDefinitions/<POLICY_DEFINITION_ID_DINE_KV_TO_MASI>",
  "metadata": {
    "category": "<ORGANIZATION_NAME> Security",
    "createdBy": "<CREATED_BY_OBJECT_ID>",
    "createdOn": "<CREATED_TIMESTAMP_UTC>",
    "updatedBy": "<UPDATED_BY_OBJECT_ID>",
    "updatedOn": "<UPDATED_TIMESTAMP_UTC>"
  },
  "mode": "Indexed",
  "name": "<POLICY_DEFINITION_ID_DINE_KV_TO_MASI>",
  "parameters": {
    "keyVaultResourceId": {
      "metadata": {
        "description": "Full ARM ID of the Key Vault to grant access to.",
        "displayName": "Key Vault resource ID"
      },
      "type": "String"
    },
    "roleDefinitionId": {
      "defaultValue": "4633458b-17de-408a-b874-0445c86b69e6",
      "metadata": {
        "description": "Default is Key Vault Secrets User.",
        "displayName": "Role definition ID"
      },
      "type": "String"
    },
    "tagName": {
      "defaultValue": "sovereignty-zone",
      "type": "String"
    },
    "tagValue": {
      "defaultValue": "comprehensive",
      "type": "String"
    }
  },
  "policyRule": {
    "if": {
      "allOf": [
        {
          "equals": "Microsoft.HybridCompute/machines",
          "field": "type"
        },
        {
          "equals": "[parameters('tagValue')]",
          "field": "[concat('tags[', parameters('tagName'), ']')]"
        },
        {
          "contains": "SystemAssigned",
          "field": "identity.type"
        }
      ]
    },
    "then": {
      "details": {
        "deployment": {
          "properties": {
            "mode": "incremental",
            "parameters": {
              "arcMachineId": {
                "value": "[field('id')]"
              },
              "keyVaultResourceId": {
                "value": "[parameters('keyVaultResourceId')]"
              },
              "roleDefinitionId": {
                "value": "[parameters('roleDefinitionId')]"
              }
            },
            "template": {
              "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
              "contentVersion": "1.0.0.0",
              "parameters": {
                "arcMachineId": {
                  "type": "string"
                },
                "keyVaultResourceId": {
                  "type": "string"
                },
                "roleDefinitionId": {
                  "type": "string"
                }
              },
              "resources": [
                {
                  "apiVersion": "2022-04-01",
                  "name": "[guid(parameters('keyVaultResourceId'), parameters('arcMachineId'), parameters('roleDefinitionId'))]",
                  "properties": {
                    "principalId": "[reference(parameters('arcMachineId'), '2025-01-13', 'Full').identity.principalId]",
                    "principalType": "ServicePrincipal",
                    "roleDefinitionId": "[concat('/providers/Microsoft.Authorization/roleDefinitions/', parameters('roleDefinitionId'))]"
                  },
                  "scope": "[parameters('keyVaultResourceId')]",
                  "type": "Microsoft.Authorization/roleAssignments"
                }
              ]
            }
          }
        },
        "existenceCondition": {
          "equals": "[guid(parameters('keyVaultResourceId'), field('id'), parameters('roleDefinitionId'))]",
          "field": "name"
        },
        "existenceScope": "Subscription",
        "roleDefinitionIds": [
          "/providers/Microsoft.Authorization/roleDefinitions/36243c78-bf99-498c-9df9-86d9f8d28608",
          "/providers/Microsoft.Authorization/roleDefinitions/18d7d88d-d35e-4fb5-a5c3-7773c20a72d9"
        ],
        "type": "Microsoft.Authorization/roleAssignments"
      },
      "effect": "deployIfNotExists"
    }
  },
  "policyType": "Custom",
  "systemData": {
    "createdAt": "<CREATED_TIMESTAMP_UTC>",
    "createdBy": "<CREATED_BY_UPN_OR_SPN>",
    "createdByType": "User",
    "lastModifiedAt": "<UPDATED_TIMESTAMP_UTC>",
    "lastModifiedBy": "<UPDATED_BY_UPN_OR_SPN>",
    "lastModifiedByType": "User"
  },
  "type": "Microsoft.Authorization/policyDefinitions",
  "version": "1.0.0",
  "versions": [
    "1.0.0"
  ]
}
