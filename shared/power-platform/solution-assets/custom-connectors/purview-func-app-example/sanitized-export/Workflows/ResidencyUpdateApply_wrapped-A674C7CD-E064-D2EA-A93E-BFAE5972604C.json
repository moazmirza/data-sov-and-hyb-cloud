        "composeApplied": {
          "runAfter": {
            "ResidencyUpdateApply": [
              "Succeeded",
              "Failed"
            ]
          },
          "type": "Compose",
          "inputs": "@or(\r\n  and(\r\n    equals(int(outputs('ResidencyUpdateApply')?['statusCode']), 200),\r\n    equals(coalesce(outputs('ResidencyUpdateApply')?['body']?['ok'], false), true)\r\n  ),\r\n  and(\r\n    equals(int(outputs('ResidencyUpdateApply')?['statusCode']), 409),\r\n    equals(\r\n      toLower(string(coalesce(outputs('ResidencyUpdateApply')?['body']?['currentResidencyCode'], ''))),\r\n      toLower(string(coalesce(outputs('ResidencyUpdateApply')?['body']?['targetResidencyCode'], '')))\r\n    )\r\n  )\r\n)"
        },
        "composeMessage": {
          "runAfter": {
            "composeAlreadyAtTarget": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@if(\r\n  equals(outputs('composeAlreadyAtTarget'), true),\r\n  concat(\r\n    'No change needed — Purview residency is already set to ',\r\n    coalesce(outputs('ResidencyUpdateApply')?['body']?['currentResidencyCode'], '(unknown)'),\r\n    ' for ',\r\n    coalesce(outputs('ResidencyUpdateApply')?['body']?['dataProductDisplayName'], 'the data product'),\r\n    '.'\r\n  ),\r\n  if(\r\n    equals(int(outputs('ResidencyUpdateApply')?['statusCode']), 409),\r\n    concat(\r\n      'Update was not applied because the preview became stale. Current Purview residency is ',\r\n      coalesce(outputs('ResidencyUpdateApply')?['body']?['currentResidencyCode'], '(unknown)'),\r\n      '. Please run preview again before applying.'\r\n    ),\r\n    concat(\r\n      'Purview residency update completed for ',\r\n      coalesce(outputs('ResidencyUpdateApply')?['body']?['dataProductDisplayName'], 'the data product'),\r\n      '.'\r\n    )\r\n  )\r\n)"
        },
        "composeActionStatus": {
          "runAfter": {
            "composeMessage": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@coalesce(\r\n  body('ResidencyUpdateApply')?['actionLogRecord']?['ActionStatus'],\r\n  body('ResidencyUpdateApply')?['status'],\r\n  body('ResidencyUpdateApply')?['Status'],\r\n  'unknown'\r\n)"
        },
        "composeVerifiedMatch": {
          "runAfter": {
            "composeActionStatus": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@equals(\r\n  toLower(string(coalesce(outputs('ResidencyUpdateApply')?['body']?['currentResidencyCode'], ''))),\r\n  toLower(string(coalesce(outputs('ResidencyUpdateApply')?['body']?['targetResidencyCode'], '')))\r\n)"
        },
        "composeConfirm": {
          "runAfter": {
            "composeVerifiedMatch": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": true
        },
        "composeNormalizeExpectedCurrentResidencyCode": {
          "runAfter": {},
          "type": "Compose",
          "inputs": "@if(\r\n  or(\r\n    empty(triggerBody()?['expectedCurrentResidencyCode']),\r\n    equals(trim(string(triggerBody()?['expectedCurrentResidencyCode'])), ''),\r\n    equals(toLower(trim(string(triggerBody()?['expectedCurrentResidencyCode']))), 'null')\r\n  ),\r\n  '',\r\n  trim(string(triggerBody()?['expectedCurrentResidencyCode']))\r\n)"
        },
        "composeAlreadyAtTarget": {
          "runAfter": {
            "composeApplied": [
              "Succeeded"
            ]
          },
          "type": "Compose",
          "inputs": "@and(\r\n  equals(int(outputs('ResidencyUpdateApply')?['statusCode']), 409),\r\n  equals(\r\n    toLower(coalesce(outputs('ResidencyUpdateApply')?['body']?['currentResidencyCode'], '')),\r\n    toLower(coalesce(outputs('ResidencyUpdateApply')?['body']?['targetResidencyCode'], ''))\r\n  )\r\n)"
